# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (phase 6) ---
# Projet → Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=
# Projet → Settings → API → "anon / public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Projet → Settings → API → "service_role" (NE JAMAIS préfixer NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- Brevo (notifications e-mail et newsletter) ---
# Brevo → Mon compte → Clés API
BREVO_API_KEY=
# Brevo → Contacts → Listes → (créer une liste "Newsletter KOM'MEL") → copier son ID
BREVO_LIST_ID=
# Brevo → Campagnes e-mail → Modèles → (créer un modèle de double opt-in) → copier son ID
BREVO_DOI_TEMPLATE_ID=
# URL vers laquelle Brevo redirige après confirmation (ex: https://kommel.fr/merci-inscription)
BREVO_DOI_REDIRECT_URL=
# Brevo → Paramètres → Expéditeurs et IP → adresse validée
BREVO_SENDER_EMAIL=contact@kommel.fr
BREVO_SENDER_NAME=KOM'MEL
# Adresse interne qui reçoit les notifications de nouvelles demandes / messages
NOTIFY_EMAIL=contact@kommel.fr

# --- HelloAsso (widget de don) ---
# URL iframe fournie par HelloAsso dans le panneau de gestion de formulaire
NEXT_PUBLIC_HELLOASSO_WIDGET_URL=

# --- Cloudflare Turnstile (CAPTCHA invisible, optionnel) ---
# Cloudflare → Turnstile → Sites → Ajouter un site → "Sitekey"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare → Turnstile → Sites → Ajouter un site → "Secret key"
TURNSTILE_SECRET_KEY=

# --- Sécurité du rate-limiting ---
# Chaîne aléatoire (openssl rand -hex 32) utilisée pour hacher les IPs
RATE_LIMIT_SALT=
